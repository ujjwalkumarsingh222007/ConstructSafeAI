# =============================================================================
# ConstructSafe AI — Enterprise Production Environment Template
# Copy this file to .env and configure all secrets before production deployment
# DO NOT commit real secrets or credentials to source control
# =============================================================================

# Application Environment (production / staging / development)
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="ConstructSafe AI"
VERSION=1.0.0
API_V1_STR=/api/v1

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE_URL=https://app.constructsafe.example.com/api/v1
# Set to 'false' in production to disable one-click demo credentials on the login screen
VITE_ENABLE_DEMO_LOGIN=false

# Backend Configuration
BACKEND_PORT=8000
# Strictly comma-separated production origins (no wildcards in production)
BACKEND_CORS_ORIGINS=["https://app.constructsafe.example.com"]

# MongoDB Database Configuration
# In production, use authenticated URI with TLS/SSL:
# mongodb://cs_app_user:STRONG_SECURE_PASSWORD@mongo.internal:27017/constructsafe_db?authSource=admin&tls=true
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=constructsafe_db
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_POOL_SIZE=100
MONGODB_TIMEOUT_MS=5000

# Redis Cache & Broker Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cryptographic Security & JWT Authentication
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=GENERATE_HIGH_ENTROPY_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Brute-Force Defense & Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Distributed Rate Limiting (Requests per minute per IP / User)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REFRESH_PER_MINUTE=30
RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=5
RATE_LIMIT_AI_ANALYSIS_PER_MINUTE=15
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_EXPORTS_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# AI Vision Inference Microservice
AI_ENGINE_PORT=8001
AI_ENGINE_HOST=localhost
HAZARD_MODEL_PATH=ai_engine/models/yolov8n.pt
HAZARD_DEMO_MODE=false

# File Storage Locations
STORAGE_DIR=./storage
EVIDENCE_DIR=./storage/evidence
REPORTS_DIR=./storage/reports
